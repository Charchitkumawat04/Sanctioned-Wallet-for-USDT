SELECT
  substring(data from 13) as banned_address,
  block_time as ban_time,
  CONCAT('https://etherscan.io/tx/0x', to_hex(tx_hash)) as tx
FROM ethereum.logs
WHERE
  contract_address = 0xdac17f958d2ee523a2206206994597c13d831ec7
  AND topic0 = 0x42e160154868087d6bfdc0ca23d96a1c1cfa32f1b72ba9ba27b69b98a0d819dc
ORDER BY ban_time DESC
